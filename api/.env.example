# --- Core ---
# Database connection URL (SQLAlchemy); Postgres example: postgresql+psycopg://pine:pine@db:5432/pine
DATABASE_URL=sqlite:///./pine.db
# Directory where uploaded blobs and derived artifacts are stored
STORAGE_DIR=./storage
# If set, all /api/* routes (except /api/v1/health) require the X-API-Key header
PINE_API_KEY=
# Allowed web origin for CORS
WEB_ORIGIN=http://localhost:3000
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- OpenAI / providers ---
OPENAI_API_KEY=
# Override for a compatible endpoint (only this host is ever called)
OPENAI_BASE_URL=
# LLM backend: fake | openai
LLM_PROVIDER=fake
# Embeddings backend: hash | openai
EMBEDDINGS_PROVIDER=hash
# Optional fallback when the embeddings provider fails
EMBEDDINGS_FALLBACK=
# Reranker backend: none | llm | cross-encoder
RERANKER=none

# --- Model routing (ARCHITECTURE §10) ---
MODEL_DEFAULT=gpt-5-mini
MODEL_FINANCIAL=gpt-5
MODEL_IC=gpt-5
MODEL_EXTRACT=gpt-5-mini
MODEL_RERANK=gpt-5-mini
# Cache LLM responses keyed by request hash (stores response bodies when 1)
LLM_CACHE=1

# --- Run cost caps (EVAL_GUARDRAILS §4) ---
RUN_MAX_TOKENS=1500000
RUN_MAX_COST_USD=10

# --- OCR ---
OCR_ENABLED=false
TESSERACT_CMD=

# --- Worker ---
WORKER_ENABLED=1
WORKER_CONCURRENCY=4

# --- Upload limits ---
MAX_FILE_MB=200
MAX_DEAL_GB=2
