# Database connection URL (SQLAlchemy)
DATABASE_URL=sqlite:///./pine.db

# If set, all /api/* routes (except /api/v1/health) require the X-API-Key header
PINE_API_KEY=

# OpenAI API key (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# LLM backend: fake | openai
LLM_PROVIDER=fake

# Embeddings backend: hash | openai
EMBEDDINGS_PROVIDER=hash

# Reranker backend: none | ...
RERANKER=none

# Enable OCR fallback for scanned documents (requires the `ocr` extra)
OCR_ENABLED=false

# Directory where uploaded blobs and derived artifacts are stored
STORAGE_DIR=./storage

# Maximum upload size per file, in megabytes
MAX_FILE_MB=200
